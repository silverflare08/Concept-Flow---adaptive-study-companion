# Local development defaults. Copy to .env only if you need to override them.
# .env is ignored by Git; never put private API keys in this example file.
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# CPU-friendly default; raise to 5-10 for slower decoding that may improve accuracy.
WHISPER_BEAM_SIZE=1
CONCEPTFLOW_CACHE_DIR=data/cache

# Optional welcome email (SMTP with STARTTLS). Disabled when host/from are blank.
# Put real credentials only in .env, never in this example or GitHub.
CONCEPTFLOW_SMTP_HOST=
CONCEPTFLOW_SMTP_PORT=587
CONCEPTFLOW_EMAIL_FROM=
CONCEPTFLOW_SMTP_USERNAME=
CONCEPTFLOW_SMTP_PASSWORD=
